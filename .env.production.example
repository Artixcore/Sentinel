APP_NAME=Sentinel
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_32_BYTE_BASE64_KEY
APP_DEBUG=false
APP_URL=https://sentinel.example.com
FRONTEND_URL=https://sentinel.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sentinel
DB_USERNAME=sentinel
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_ROOT_PASSWORD

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

SENTINEL_INGEST_TOKEN=REPLACE_WITH_LONG_RANDOM_INGEST_TOKEN
NEXT_PUBLIC_API_URL=https://sentinel.example.com/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
